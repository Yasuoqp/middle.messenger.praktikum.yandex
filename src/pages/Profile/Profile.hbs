      <span class="profile-back-arrow">←</span>
    </a>
  </div>

  <div class="profile-content">
    <div class="profile-header">
      <div class="profile-avatar">
        <img src="/src/assets/img/Union.png" alt="Avatar" class="profile-avatar-image">
      </div>
      <div class="profile-info">
        {{{profileContent}}}
      </div>
    </div>
  </div>
</div>
