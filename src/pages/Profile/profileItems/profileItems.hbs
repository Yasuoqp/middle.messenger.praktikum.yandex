<div class="profile-container">
  <div class="profile-header">
    <h3 class="profile-name">{{firstName}} {{lastName}}</h3>
  </div>
  <div class="profile-details">
    <div class="profile-field">
      <p class="field-label">Почта</p>
      <span class="field-value">{{email}}</span>
    </div>
    <div class="profile-field">
      <p class="field-label">Телефон</p>
      <span class="field-value">{{phone}}</span>
    </div>
    <div class="profile-field">
      <p class="field-label">Логин</p>
      <span class="field-value">{{login}}</span>
    </div>
    <div class="profile-field">
      <p class="field-label">Чат</p>
      <span class="field-value">{{chatName}}</span>
    </div>
  </div>
</div>